# Server-side LLM Configuration (OpenAI Compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_MOCK_FALLBACK=True

# Database Configuration (SQLite default / PostgreSQL for production)
DATABASE_URL=sqlite:///./abi_agent.db

# Application Configuration
APP_URL=http://localhost:5173
DEBUG=False

# CORS — comma-separated list of allowed frontend origins
# REQUIRED in production: replace with your actual deployed frontend URL(s)
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
